generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  author    String   @default("Anonymous")
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}